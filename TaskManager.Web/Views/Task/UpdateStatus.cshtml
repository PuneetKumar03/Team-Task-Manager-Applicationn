@model TaskManager.Web.ViewModels.TaskUpdateStatusViewModel
@{
    ViewData["Title"] = "Update Status";
}

<div class="tm-form-card">
    <div class="tm-form-title">Update task status</div>
    <div class="tm-form-subtitle" style="margin-bottom:8px">@Model.Title</div>
    <div style="font-size:12px;color:#6366f1;margin-bottom:24px;font-weight:500">
        <i class="bi bi-folder2-open me-1"></i>@Model.ProjectName
    </div>

    <form asp-action="UpdateStatus" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3 mb-3"></div>

        <div class="mb-4">
            <label asp-for="NewStatus" class="form-label">New status</label>
            <select asp-for="NewStatus" asp-items="Model.StatusList" class="form-select"></select>
        </div>
        <div class="mb-4">
            <label class="form-label d-flex justify-content-between">
                <span>Progress</span>
                <span style="color:#6366f1;font-weight:600" id="prog-val">@Model.ProgressPercentage%</span>
            </label>
            <input asp-for="ProgressPercentage" type="range" class="form-range"
                   min="0" max="100" step="5"
                   oninput="document.getElementById('prog-val').textContent = this.value + '%'" />
            <div class="d-flex justify-content-between" style="font-size:11px;color:#94a3b8;margin-top:4px">
                <span>0%</span><span>50%</span><span>100%</span>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn-tm-primary">Save changes</button>
            <a asp-action="Index" class="btn-tm-outline text-decoration-none">Cancel</a>
        </div>
    </form>
</div>