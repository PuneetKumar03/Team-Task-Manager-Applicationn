@using TaskManager.Utility.Constants
@model TaskManager.Web.ViewModels.ProjectDetailsViewModel
@{
    ViewData["Title"] = Model.Project.Name;
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h5 style="font-weight:700;color:#1a1a2e;margin:0">@Model.Project.Name</h5>
        <p style="font-size:13px;color:#94a3b8;margin:4px 0 0">@(Model.Project.Description ?? "No description")</p>
    </div>
    <a asp-action="Index" class="btn-tm-outline btn-tm-sm text-decoration-none d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i>Back
    </a>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="tm-card">
            <div class="tm-card-head">
                <span class="tm-card-title">Tasks <span style="color:#94a3b8;font-weight:400">(@Model.Project.Tasks.Count)</span></span>
                @if (User.IsInRole(SD.Role_Admin))
                {
                    <a asp-controller="Task" asp-action="Create" asp-route-projectId="@Model.Project.Id"
                           class="btn-tm-primary btn-tm-sm text-decoration-none d-inline-flex align-items-center gap-1">
                        <i class="bi bi-plus-lg"></i>Add task
                    </a>
                }
            </div>
            @if (!Model.Project.Tasks.Any())
            {
                <div class="tm-empty"><i class="bi bi-clipboard2-x"></i>No tasks yet</div>
            }
            else
            {
                <table class="tm-table">
                    <thead>
                        <tr><th>Task</th><th>Assignee</th><th>Priority</th><th>Status</th><th>Progress</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model.Project.Tasks)
                        {
                            <tr>
                                <td>
                                    <div style="font-size:13px;font-weight:500;color:#1a1a2e">@task.Title</div>
                                    @if (task.Deadline.HasValue)
                                    {
                                        <div style="font-size:11px;color:#94a3b8">Due @task.Deadline.Value.ToString("dd MMM yyyy")</div>
                                    }
                                </td>
                                <td style="font-size:12px;color:#64748b">@(task.AssignedTo?.FullName ?? "Unassigned")</td>
                                <td><span class="tm-badge tm-badge-@task.Priority.ToString().ToLower()">@task.Priority</span></td>
                                <td>
                                    @{
                                        var statusClass = task.Status.ToString() switch
                                        {
                                            "Todo" => "todo",
                                            "InProgress" => "progress",
                                            "InReview" => "review",
                                            "Completed" => "done",
                                            _ => "todo"
                                        };
                                    }
                                    <span class="tm-badge tm-badge-@statusClass">@task.Status</span>
                                </td>
                                <td>
                                    <div class="tm-progress" style="width:80px">
                                        <div class="tm-progress-fill" style="width:@task.ProgressPercentage%"></div>
                                    </div>
                                    <div style="font-size:11px;color:#94a3b8;margin-top:3px">@task.ProgressPercentage%</div>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-controller="Task" asp-action="UpdateStatus" asp-route-id="@task.Id"
                                           class="btn-tm-primary btn-tm-sm text-decoration-none">Update</a>
                                        @if (User.IsInRole(SD.Role_Admin))
                                        {
                                            <a asp-controller="Task" asp-action="Edit" asp-route-id="@task.Id"
                                               class="btn-tm-outline btn-tm-sm text-decoration-none">Edit</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="tm-card mb-3">
            <div class="tm-card-head">
                <span class="tm-card-title">Members <span style="color:#94a3b8;font-weight:400">(@Model.Project.Members.Count)</span></span>
            </div>
            @foreach (var member in Model.Project.Members)
            {
                <div style="display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #f8fafc">
                    <div style="width:32px;height:32px;border-radius:50%;background:#eef2ff;color:#4338ca;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">
                        @(member.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div style="flex:1">
                        <div style="font-size:13px;font-weight:500;color:#1a1a2e">@member.User?.FullName</div>
                        <div style="font-size:11px;color:#94a3b8">@member.User?.Email</div>
                    </div>
                    @if (User.IsInRole(SD.Role_Admin))
                    {
                        <form asp-action="RemoveMember" method="post" onsubmit="return confirm('Remove member?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="projectId" value="@Model.Project.Id" />
                            <input type="hidden" name="userId" value="@member.UserId" />
                            <button type="submit" class="btn-tm-danger" style="padding:5px 10px">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </form>
                    }
                </div>
            }
        </div>

        @if (User.IsInRole(SD.Role_Admin) && Model.AvailableMembers.Any())
        {
            <div class="tm-card">
                <div class="tm-card-head"><span class="tm-card-title">Add member</span></div>
                <div style="padding:16px">
                    <form asp-action="AddMember" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ProjectId" value="@Model.Project.Id" />
                        <select name="UserId" class="form-select form-select-sm mb-2">
                            @foreach (var m in Model.AvailableMembers)
                            {
                                <option value="@m.UserId">@m.FullName (@m.Email)</option>
                            }
                        </select>
                        <button type="submit" class="btn-tm-primary w-100">Add to project</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>